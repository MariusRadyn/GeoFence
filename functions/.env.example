# Copy to .env for local emulator / param defaults (do NOT commit secrets).
# Password must be set with: firebase functions:secrets:set SMTP_PASS

SMTP_HOST=mail.trinityglobal.co.za
SMTP_PORT=465
SMTP_USER=info@trinityglobal.co.za
SMTP_FROM=info@trinityglobal.co.za
CONTACT_TO=info@trinityglobal.co.za

# PayFast + Bob Go (shop) — optional until merchant keys are ready.
# Leave blank to deploy; set values here when you have them:
# PAYFAST_MERCHANT_ID=
# PAYFAST_MERCHANT_KEY=
# PAYFAST_PASSPHRASE=          # required for subscriptions / recurring billing
# BOB_GO_API_TOKEN=
PAYFAST_SANDBOX=true
BOB_GO_SANDBOX=true
SHOP_RETURN_URL=https://limitless-iot-17e8f.web.app/shop-payment.html
SHOP_CANCEL_URL=https://limitless-iot-17e8f.web.app/shop-payment.html?status=cancelled
SHOP_DOMAIN=limitless-iot-17e8f.web.app
BOB_COLLECTION_STREET=46 Pope Ellis Dr
BOB_COLLECTION_SUBURB=Ashburton
BOB_COLLECTION_CITY=Pietermaritzburg
BOB_COLLECTION_CODE=3201
BOB_COLLECTION_NAME=Trinity Global
BOB_COLLECTION_PHONE=0330000000
BOB_COLLECTION_EMAIL=info@trinityglobal.co.za

# eWeLink / SONOFF (required for third-party IoT)
# Create an app at https://dev.ewelink.cc/ and paste credentials here.
# Redirect URL must match exactly what you register in the developer console:
EWELINK_APP_ID=
EWELINK_APP_SECRET=
EWELINK_REDIRECT_URL=https://europe-west1-limitless-iot-17e8f.cloudfunctions.net/onEwelinkOAuthCallback
